init -9 python:
    LOCI = [{"name": "Core Vault", "glyph": "◉", "sub": "Sealed memory", "a": [1290, 430], "s": [1290, 630], "desc": "The deepest locus, behind the round door: the things that matter most. It is a place to remember, not a lock, so nothing secret goes here.", "items": ["Your most important memories", "Not a lock: never passwords or keys"], "id": "vault"}, {"name": "Agent Bay", "glyph": "☺", "sub": "Who answers you", "a": [280, 420], "s": [330, 705], "desc": "Each humming machine is an agent with a face. Pin here what you know about models, the router and helpers.", "items": ["Models, and who answers what", "The router and helpers"], "id": "agents"}, {"name": "Tool Shed", "glyph": "⚙", "sub": "What Jade can reach", "a": [700, 330], "s": [700, 705], "desc": "Cabinets of tools, skills and servers. Browser, SSH, MCP: everything with a plug on it is stored here.", "items": ["Tools, skills and servers", "How-tos"], "id": "tools"}, {"name": "Workbench", "glyph": "▤", "sub": "Work in progress", "a": [2040, 250], "s": [2000, 705], "desc": "Live terminals for the things being built right now: flows, apps and the think vault.", "items": ["Work in progress", "Projects, flows, drafts"], "id": "bench"}, {"name": "Archive", "glyph": "▦", "sub": "Closed chapters", "a": [2350, 470], "s": [2350, 705], "desc": "Grey lockers of finished conversations and backups. Nothing is deleted here, only filed.", "items": ["Finished things", "Old chats and backups"], "id": "archive"}, {"name": "The Stacks", "glyph": "≡", "sub": "Knowledge", "a": [700, 900], "s": [330, 1150], "desc": "Rows of server racks holding what Jade knows: notes, documents and the vector memory.", "items": ["Facts and notes", "Documents and references"], "id": "stacks"}, {"name": "Fleet Console", "glyph": "⌖", "sub": "Other devices", "a": [820, 1255], "s": [900, 1150], "desc": "The bottom consoles watch the rest of the fleet: the broker, phones and every other copy of Jade.", "items": ["Other devices", "Machines Jade can reach"], "id": "fleet"}, {"name": "Comms Desk", "glyph": "✉", "sub": "Messages in and out", "a": [1700, 930], "s": [1580, 1140], "desc": "Three monitors, one chair. Messenger bridges and Discord come in here.", "items": ["People", "Messages and channels"], "id": "comms"}, {"name": "Schedule Deck", "glyph": "◷", "sub": "Things on a timer", "a": [1850, 1250], "s": [1900, 1140], "desc": "Console row for everything that wakes Jade up on its own: heartbeat, schedules, curiosity.", "items": ["Reminders", "Routines and things on a timer"], "id": "deck"}, {"name": "Trajectory Lockers", "glyph": "☆", "sub": "Every run, filed", "a": [2310, 960], "s": [2310, 1140], "desc": "Each run is filed in a locker with a thumbs-up or thumbs-down. This is the raw material for tuning.", "items": ["Past runs", "Ratings and lessons"], "id": "lockers"}, {"name": "The Gate", "glyph": "△", "sub": "Outside world", "a": [1300, 1385], "s": [1300, 1392], "desc": "The only way out. Web pages, the browser and everything that is not the vault.", "items": ["The outside world", "Links and errands"], "id": "gate"}]
